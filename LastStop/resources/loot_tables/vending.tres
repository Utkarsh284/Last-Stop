[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://scripts/loot/loot_entry.gd" id="1_entry"]
[ext_resource type="Script" path="res://scripts/loot/loot_table.gd" id="1_table"]
[ext_resource type="Resource" path="res://resources/items/canned_food.tres" id="2_canned_food"]
[ext_resource type="Resource" path="res://resources/items/bottled_water.tres" id="3_bottled_water"]

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("1_entry")
item = ExtResource("2_canned_food")
